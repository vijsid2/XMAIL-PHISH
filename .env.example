# BACKEND CONFIGURATION
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-super-secret-key-change-in-production

# DATABASE - SUPABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# THREAT INTELLIGENCE APIs
VIRUSTOTAL_API_KEY=your-virustotal-api-key
ABUSEIPDB_API_KEY=your-abuseipdb-api-key
OPENPHISH_URL=https://openphish.com/feed.txt
PHISHTANK_API_KEY=your-phishtank-api-key
ALIENVAULT_OTX_API_KEY=your-alienvault-api-key
SPAMHAUS_API_KEY=your-spamhaus-api-key

# CORS CONFIGURATION
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT TOKENS
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRATION=86400

# FILE UPLOAD
MAX_FILE_SIZE=25
ALLOWED_EXTENSIONS=eml,msg,txt

# RATE LIMITING
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# SECURITY
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_SECURITY_POLICY=True

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=logs/xmail-phish.log

# FRONTEND
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key
